FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y \
    libportaudio2 \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN pip install --no-cache-dir .

ENV ACOUSTIC_CONFIG=""
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m", "acoustic_engine.runner"]
CMD []
